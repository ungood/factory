#!/usr/bin/env bash
# Runs Claude on a GitHub issue in an Orca terminal, where a person can watch
# it and take over, and waits until the agent writes its result file.
#
# Usage: agent <repo> <issue> <worktree>
#
# <repo> is a path to a checkout, relative to the current directory, and
# <worktree> is the Orca worktree prepare made for the issue. The agent
# commits, pushes and opens the pull request itself. Prints the result as
# JSON: {"status", "pullRequest", "summary"}. Exits non-zero when the
# agent reports it's blocked or the terminal exits without a result.
#
# A retried step finds the terminal and result from the first attempt and
# picks up where it left off, so a worker crash never starts a second agent
# on the same issue.
set -euo pipefail

repo=$(git -C "$1" rev-parse --show-toplevel)
issue=$2
path=$3
bin=$(cd "$(dirname "$0")" && pwd)
name="issue-$issue"
state="${XDG_STATE_HOME:-$HOME/.local/state}/factory/agents/$(basename "$repo")-$issue"
result="$state/result.json"
mkdir -p "$state"

log() { echo "agent: $*" >&2; }

nwo=$(gh repo view "$(git -C "$repo" remote get-url origin)" --json nameWithOwner -q .nameWithOwner)
branch=$(git -C "$path" branch --show-current)

terminals() { orca terminal list --worktree "path:$path" --json | jq -c '.result.terminals'; }
has_terminal() { terminals | jq -e --arg t "$1" 'any(.[]; .handle == $t)' >/dev/null; }

# orca terminal wait exits non-zero when it times out, so read satisfied
# from its output instead of letting set -e end the script.
wait_for() {
  orca terminal wait --terminal "$1" --for "$2" --timeout-ms "$3" --json 2>/dev/null |
    jq -r '.result.wait.satisfied // false' || true
}

if [ ! -f "$result" ]; then
  # The handle of the terminal Claude was started in. A retried step reuses
  # it rather than starting a second agent.
  if [ -f "$state/terminal" ]; then
    terminal=$(cat "$state/terminal")
    if ! has_terminal "$terminal"; then
      log "the agent's terminal $terminal is gone, and there's no $result. Look at $path."
      exit 1
    fi
  else
    # Orca's worktrees live outside the workplace, so the workplace's
    # untracked mise.local.toml doesn't reach them. Carry over the Claude
    # account the source checkout uses.
    config_dir=$(mise -C "$repo" env --json | jq -r '.CLAUDE_CONFIG_DIR // empty')
    if [ -z "$config_dir" ]; then
      log "$repo has no CLAUDE_CONFIG_DIR in its mise environment"
      exit 1
    fi

    cat >"$state/task.md" <<EOF
You're working on issue #$issue in $nwo, in this worktree on branch \`$branch\`. The issue follows this section.

Write failing tests first wherever the repo has tests, then implement. Run the repo's checks, which are \`mise run ci\` if the repo defines a \`ci\` task, or else \`mise run lint\` and \`mise run test\` where they exist, and fix what fails. Document a change in the doc for the step or feature you changed, such as a doc next to its script or test, rather than in an overview that other changes edit too. In ungood/factory, each SDLC step has its own doc in \`sdlc/docs\`, named after its script. Don't renumber a list to make room for a new item. Commit your work with conventional commit messages.

Then push the branch and open a draft pull request with a conventional title. Its body summarizes the change and ends with \`Closes #$issue\`. If the repo has a pull request template, such as \`.github/pull_request_template.md\`, follow it. Don't bypass the repo's git hooks: if the pre-push hook fails, fix what it reports and push again. CI on the pull request runs the repo's checks, and the workflow checks that the pull request's head is your \`HEAD\` and that nothing is left uncommitted.

When you're done, write this JSON to \`$result\`:

    {"status": "done", "pullRequest": "<the pull request's URL>", "summary": "<what you did>"}

If you're blocked and need a person, write {"status": "blocked", "summary": "<what's blocking you>"} instead. A person may be watching this terminal and may take over; if they do, follow their lead.

Writing the result file must be your last action: the workflow reads it as soon as you're back at your prompt. Write it to \`$result.tmp\` first, then \`mv\` it into place, so the workflow never sees a half-written file.

$(cat "$state/issue.md")
EOF

    log "starting Claude in $path"
    terminal=$(terminals | jq -r '.[0].handle // empty')
    if [ -z "$terminal" ]; then
      terminal=$(orca terminal create --worktree "path:$path" --title "$name" --json |
        jq -r '.result.terminal.handle')
    fi
    echo "$terminal" >"$state/terminal"
    orca terminal send --terminal "$terminal" \
      --text "env CLAUDE_CONFIG_DIR='$config_dir' mise x -- claude" --enter --json >/dev/null

    # The shell counts as idle too, so wait for Claude to claim the terminal
    # before waiting for its prompt.
    for _ in $(seq 60); do
      [ "$(terminals | jq -r --arg t "$terminal" '.[] | select(.handle == $t) | .agentIdentity')" = claude ] && break
      sleep 1
    done
    if [ "$(wait_for "$terminal" tui-idle 120000)" != true ]; then
      log "Claude didn't become ready in $path"
      exit 1
    fi
    orca terminal send --terminal "$terminal" \
      --text "Read $state/task.md and do what it says." --enter --wait-submit 30 --json >/dev/null
    orca worktree set --worktree "path:$path" --comment "implementing #$issue" \
      --workspace-status in-progress --json >/dev/null || true
  fi
fi

# A retried step also waits for the agent to go idle, in case the worker
# crashed while the agent was still editing its result.
terminal=$(cat "$state/terminal" 2>/dev/null || true)
answer=$("$bin/await-result" "$result" "$terminal" "path:$path")
echo "$answer"
status=$(jq -r '.status' <<<"$answer")
if [ "$status" != "done" ]; then
  log "the agent reported $status: $(jq -r '.summary' <<<"$answer")"
  exit 1
fi
