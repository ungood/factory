#!/usr/bin/env bash
# Marks an approved pull request ready and merges it, then moves the run's
# Orca worktree to completed.
#
# Usage: merge <worktree> <pull request>
#
# Merges only the commit the worktree last pushed, so nothing the reviewer
# hasn't seen goes in. A pull request that's already merged counts as done.
set -euo pipefail

worktree=$1
url=$(tr -d "[:space:]" <<<"$2")

log() { echo "merge: $*" >&2; }

if [ "$(gh pr view "$url" --json state -q .state)" != MERGED ]; then
  if [ "$(gh pr view "$url" --json isDraft -q .isDraft)" = true ]; then
    gh pr ready "$url" >&2
  fi
  # The remote branch goes with the merge. The local one goes in cleanup,
  # after the retrospective.
  gh pr merge "$url" --merge --match-head-commit "$(git -C "$worktree" rev-parse HEAD)" >&2
fi
log "merged $url"

orca worktree set --worktree "path:$worktree" --comment "merged ${url##*/pull/}" \
  --workspace-status completed --json >/dev/null || log "couldn't update the worktree $worktree in Orca"
