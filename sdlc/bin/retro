#!/usr/bin/env bash
# Reviews how an implement run went and files up to three issues that would
# make the next run go better, each labeled `retro` and linking the PR. It
# runs once the review is over, so it sees each round of review feedback too.
# It also reads the reviewer's feedback that no round handled, such as a
# review left with the merge, and files an issue for each idea for follow-up
# work in it. Those don't count toward the three.
#
# Usage: retro <repo> <issue> <worktree> <pull request> <run>
#
# <repo> is the path to the checkout the run worked on, relative to the
# current directory, which must be the factory workplace. <run> is the marche
# run's workflow ID. Prints the URLs of the filed issues as a JSON array.
#
# The review is a headless, read-only `claude -p`. It proposes the issues,
# and this script files them, so the agent itself can't change anything. The
# step never fails the run: any failure is logged, and the script still exits
# zero with whatever it filed so far.
set -euo pipefail

filed=()
inputs=
log() { echo "retro: $*" >&2; }
finish() {
  status=$?
  [ "$status" -eq 0 ] || log "the retrospective failed with status $status; the pull request stands"
  [ -z "$inputs" ] || rm -rf "$inputs"
  if [ "${#filed[@]}" -eq 0 ]; then echo '[]'; else printf '%s\n' "${filed[@]}" | jq -R . | jq -cs .; fi
  exit 0
}
trap finish EXIT

repo=$(git -C "$1" rev-parse --show-toplevel)
issue=$2
worktree=$3
pr=$4
run=$5
workplace=$PWD
bin=$(cd "$(dirname "$0")" && pwd)
state="${XDG_STATE_HOME:-$HOME/.local/state}/factory/agents/$(basename "$repo")-$issue"

factory_nwo=$(gh repo view "$(git remote get-url origin)" --json nameWithOwner -q .nameWithOwner)
repo_nwo=$(gh repo view "$(git -C "$repo" remote get-url origin)" --json nameWithOwner -q .nameWithOwner)

# The same Claude account the agent ran on, which is also where its
# transcript is.
config_dir=$(mise -C "$repo" env --json | jq -r '.CLAUDE_CONFIG_DIR // empty')
if [ -z "$config_dir" ]; then
  log "$repo has no CLAUDE_CONFIG_DIR in its mise environment"
  exit 1
fi

# Gather the inputs in one directory, so the review only needs to read there,
# the worktree and the workplace.
inputs=$(mktemp -d "${TMPDIR:-/tmp}/retro.XXXXXX")
cp "$state/issue.md" "$inputs/issue.md"
cp "$state/result.json" "$inputs/result.json"
# Each round of review feedback, and the agent's result for it.
for f in "$state"/feedback-*.json "$state"/result-*.json; do
  [ ! -f "$f" ] || cp "$f" "$inputs/"
done
# The reviewer's feedback that no round handled: anything left with the
# merge or after it, or with a close.
if ! "$bin/review-state" --feedback "$repo" "$issue" "$pr" >"$inputs/unhandled.json"; then
  log "couldn't read the feedback no round handled"
  echo '[]' >"$inputs/unhandled.json"
fi
gh pr diff "$pr" >"$inputs/pr.diff"
# Claude keeps a worktree's sessions in a directory named after its path.
transcripts="$config_dir/projects/${worktree//[^A-Za-z0-9]/-}"
if [ -d "$transcripts" ]; then
  cp -R "$transcripts" "$inputs/transcripts"
else
  log "no Claude transcripts in $transcripts"
fi
marche show --json "$run" >"$inputs/run.json"
mkdir "$inputs/logs"
jq -r '.tasks[] | select(.log != null) | [.name, .log] | @tsv' "$inputs/run.json" |
  while IFS=$'\t' read -r name path; do
    # Keep every attempt of the step, not only the one marche reports.
    mkdir -p "$inputs/logs/$name"
    cp "$(dirname "$path")"/* "$inputs/logs/$name/"
  done

schema=$(jq -cn --arg factory "$factory_nwo" --arg repo "$repo_nwo" '
  {
    repo: {type: "string", enum: ([$factory, $repo] | unique)},
    title: {type: "string"},
    body: {type: "string"}
  } as $issue
  | {
    type: "object",
    properties: {
      issues: {
        type: "array",
        maxItems: 3,
        items: {type: "object", properties: $issue, required: ["repo", "title", "body"]}
      },
      followUps: {
        type: "array",
        items: {
          type: "object",
          properties: ($issue + {comment: {type: "string"}}),
          required: ["repo", "title", "body", "comment"]
        }
      }
    },
    required: ["issues", "followUps"]
  }')

prompt=$(
  cat <<EOF
You're reviewing how a run of the factory's implement workflow went, so that the next run goes better. The run took issue #$issue in $repo_nwo to the pull request $pr. An agent worked in $worktree, committed, pushed and opened the pull request, and CI on the pull request ran the repo's checks. The workflow checked that the pull request's head was the worktree's HEAD and nothing was uncommitted, and handed any problem back to the agent once. Then the run waited for the reviewer: each round of their feedback went back to the same agent, which pushed its fixes and posted its own replies, and the workflow checked again, until the reviewer merged the pull request, which is their approval, or closed it.

The run's record is in the current directory:

- \`issue.md\`: the issue, which is also the end of the agent's task.
- \`result.json\`: the result file the agent wrote.
- \`feedback-<n>.json\` and \`result-<n>.json\`, if there are any: round <n>'s review feedback, which the reviewer wrote, and the agent's result for it. The first round of feedback is round 2.
- \`unhandled.json\`: the reviewer's feedback that no round handled, such as a review left with the merge, as a JSON array of items with their \`body\` and \`url\`.
- \`pr.diff\`: the pull request's diff.
- \`transcripts/\`: the agent's Claude session transcripts for the worktree, as JSONL. They can be large, so search them rather than reading them whole.
- \`run.json\`: the marche run's tasks, with their outputs and errors.
- \`logs/<step>/\`: each step's standard output and error, one pair of files per attempt. \`logs/check/\` and \`logs/recheck/\` are the workflow's checks of the pull request, and \`logs/agent/\` includes the task the agent was given.

The workflow's own definition and scripts are in the factory workplace, $workplace, under \`sdlc/\`. The repo the run worked on is checked out at $worktree.

Look for friction in the run:

- what the agent got wrong, retried or went around in circles on
- what the git hooks, CI or the workflow's checks caught
- where the task, the issue or the scripts were unclear
- what a person had to fix by hand, which shows in the transcript as a person typing into the session
- what the reviewer asked to change that the agent could have got right the first time

Turn the friction into at most three proposed issues, each a bug to fix or a feature to add, that would have prevented it. Propose only what the evidence supports, and propose none if the run went smoothly. A bad or duplicate issue costs more than a missing one.

File each issue where it belongs: $factory_nwo for the SDLC itself (the workflow, its scripts, and the agent's task), or $repo_nwo for problems in that repo. Before proposing one, check that repo's open issues with \`gh issue list -R <repo> --state open\` and skip anything already covered.

Each issue's body must cite the evidence from this run: quote the transcript, a step's output or the diff, and say which file it came from. Then say what should change. Write plainly and briefly. Don't link the pull request; that's added for you.

Separately, the reviewer may have left ideas for follow-up work in \`unhandled.json\`. Propose each idea as its own follow-up issue, in \`followUps\` rather than \`issues\`, with the \`url\` of the item it came from as its \`comment\`. Follow-ups don't count toward the three issues, so never drop one to make room. File each where it belongs, the same way, and skip only an idea an open issue already covers. The body should state the reviewer's idea, quoting them, and add what this run shows about it. Feedback in \`unhandled.json\` that isn't an idea for follow-up work, such as a request to change this pull request, is friction to consider for \`issues\` instead.
EOF
)

# Only the tools named here, and no settings, hooks or MCP servers from the
# account, keep the review read-only.
log "reviewing the run"
review=$(cd "$inputs" && CLAUDE_CONFIG_DIR="$config_dir" claude -p "$prompt" \
  --add-dir "$worktree" "$workplace" \
  --setting-sources project \
  --strict-mcp-config \
  --tools Read Grep Glob Bash \
  --allowedTools "Bash(gh issue list:*)" "Bash(gh issue view:*)" "Bash(gh search issues:*)" \
  --permission-mode dontAsk \
  --no-session-persistence \
  --output-format json \
  --json-schema "$schema")
if [ "$(jq -r '.is_error' <<<"$review")" != false ]; then
  log "the review failed: $(jq -r '.result // .subtype' <<<"$review")"
  exit 1
fi

# The retrospective's own issues, then the reviewer's follow-ups, each with
# the footer that says where it came from.
proposals=$(jq -c --arg pr "$pr" '
  ((.structured_output.issues // [])[:3][]
    | .footer = "Proposed by the retrospective of \($pr).")
  , ((.structured_output.followUps // [])[]
    | .footer = "Proposed by the reviewer in \(.comment), and filed by the retrospective of \($pr).")' <<<"$review")
if [ -z "$proposals" ]; then
  log "the review proposed no issues"
  exit 0
fi

labeled=()
while read -r proposal; do
  nwo=$(jq -r '.repo' <<<"$proposal")
  if [ "$nwo" != "$factory_nwo" ] && [ "$nwo" != "$repo_nwo" ]; then
    log "skipping an issue for $nwo, which the run didn't touch"
    continue
  fi
  if [[ " ${labeled[*]-} " != *" $nwo "* ]]; then
    gh label create retro -R "$nwo" --force --color c5def5 \
      --description "Proposed by an SDLC retrospective" >/dev/null
    labeled+=("$nwo")
  fi
  body=$(jq -r '.body' <<<"$proposal")
  url=$(gh issue create -R "$nwo" --label retro --title "$(jq -r '.title' <<<"$proposal")" \
    --body "$(printf '%s\n\n%s\n' "$body" "$(jq -r '.footer' <<<"$proposal")")")
  log "filed $url"
  filed+=("$url")
done <<<"$proposals"
