#!/usr/bin/env bash
# Runs the deterministic checks on an agent's worktree, without trusting the
# agent's own report that they pass.
#
# Usage: gate <worktree>
#
# Fails when the worktree has uncommitted changes, has no commits beyond the
# default branch, or fails the repo's checks. A repo's checks are its ci task
# if it defines one, or else its lint and test tasks, where they exist.
set -euo pipefail

cd "$1"
log() { echo "gate: $*" >&2; }

if [ -n "$(git status --porcelain)" ]; then
  log "the worktree has uncommitted changes"
  git status --short >&2
  exit 1
fi

base=$(git symbolic-ref --quiet --short refs/remotes/origin/HEAD || echo origin/main)
if [ -z "$(git rev-list "$base..HEAD")" ]; then
  log "there are no commits beyond $base"
  exit 1
fi

# A new worktree is a new path, which mise hasn't been told to trust.
mise trust --quiet .
has_task() { mise tasks info "$1" >/dev/null 2>&1; }
if has_task ci; then
  tasks=(ci)
else
  tasks=(lint test)
fi
for task in "${tasks[@]}"; do
  if has_task "$task"; then
    log "mise run $task"
    mise run "$task" >&2
  fi
done
