#!/usr/bin/env bash
# Tests sdlc/bin/pin against a throwaway factory checkout whose sdlc/ script
# changes after a run starts.
#
# Usage: sdlc/test/pin
set -euo pipefail

root=$(cd "$(dirname "$0")/../.." && pwd)
tmp=$(mktemp -d "${TMPDIR:-/tmp}/pin-test.XXXXXX")
tmp=$(cd "$tmp" && pwd -P)
trap 'rm -rf "$tmp"' EXIT

export XDG_STATE_HOME="$tmp/state"
# Tools shimmed by mise read this checkout's config, so trust it.
export MISE_TRUSTED_CONFIG_PATHS="$root"
export GIT_AUTHOR_NAME=test GIT_AUTHOR_EMAIL=test@example.com
export GIT_COMMITTER_NAME=test GIT_COMMITTER_EMAIL=test@example.com

failures=0
expect() {
  local name=$1 want=$2 got=$3
  if [ "$got" = "$want" ]; then
    echo "ok: $name"
  else
    echo "FAIL: $name: want $want, got $got"
    failures=$((failures + 1))
  fi
}

# A factory checkout whose one script prints its version, and an app repo
# for the run to work on.
factory="$tmp/factory"
git init --quiet -b main "$factory"
mkdir -p "$factory/sdlc/bin"
version() {
  printf '#!/usr/bin/env bash\necho %s\n' "$1" >"$factory/sdlc/bin/hello"
  chmod +x "$factory/sdlc/bin/hello"
  git -C "$factory" add sdlc
  git -C "$factory" commit --quiet -m "$1"
  git -C "$factory" rev-parse HEAD
}
git init --quiet -b main "$tmp/app"

pin() { (cd "$factory" && "$root/sdlc/bin/pin" "$tmp/app" 7 "$1") 2>"$tmp/pin.err"; }

old=$(version v1)
got=$(pin run-1) || got="failed: $(cat "$tmp/pin.err")"
dir="$tmp/state/factory/agents/app-7/runs/run-1/sdlc"
expect "prints the pinned scripts and the factory commit" \
  "{\"sdlc\":\"$dir\",\"factory\":\"$old\"}" "$got"
expect "the pinned copy runs" v1 "$("$dir/bin/hello" 2>&1)"

version v2 >/dev/null
expect "the run keeps the old scripts after the checkout moves on" v1 "$("$dir/bin/hello" 2>&1)"

got=$(pin run-1) || got="failed: $(cat "$tmp/pin.err")"
expect "a retry keeps the first attempt's commit" "{\"sdlc\":\"$dir\",\"factory\":\"$old\"}" "$got"
expect "a retry keeps the first attempt's scripts" v1 "$("$dir/bin/hello" 2>&1)"

printf '#!/usr/bin/env bash\necho uncommitted\n' >"$factory/sdlc/bin/hello"
got=$(pin run-2) || got="failed: $(cat "$tmp/pin.err")"
expect "a new run pins the current commit" "v2" "$("$(jq -r .sdlc <<<"$got")/bin/hello" 2>&1)"

[ "$failures" -eq 0 ] || { echo "$failures failed"; exit 1; }
