#!/usr/bin/env bash
# Tests sdlc/bin/await-result against a fake orca whose terminal list and
# wait answer from files, and can write the result file the way an agent
# would.
#
# Usage: sdlc/test/await-result
set -euo pipefail

root=$(cd "$(dirname "$0")/../.." && pwd)
tmp=$(mktemp -d "${TMPDIR:-/tmp}/await-result-test.XXXXXX")
trap 'rm -rf "$tmp"' EXIT

# The fake orca lists the terminals in $FAKE_ORCA/terminals.json. Before it
# answers a list, it runs the script $FAKE_ORCA/on-list once, if it exists.
# A wait runs $FAKE_ORCA/on-wait the same way, then answers with the next line of
# $FAKE_ORCA/waits, true or false.
mkdir -p "$tmp/bin" "$tmp/orca"
cat >"$tmp/bin/orca" <<'ORCA'
#!/usr/bin/env bash
once() {
  if [ -f "$FAKE_ORCA/$1" ]; then
    "$FAKE_ORCA/$1"
    rm "$FAKE_ORCA/$1"
  fi
}
case "$1 $2" in
  "terminal list")
    once on-list
    jq -c '{result: {terminals: .}}' "$FAKE_ORCA/terminals.json" ;;
  "terminal wait")
    once on-wait
    satisfied=$(head -n 1 "$FAKE_ORCA/waits")
    sed -i.bak 1d "$FAKE_ORCA/waits"
    echo "{\"result\": {\"wait\": {\"satisfied\": ${satisfied:-true}}}}"
    [ "${satisfied:-true}" = true ] ;;
  *) echo "fake orca: unexpected call: $*" >&2; exit 1 ;;
esac
ORCA
chmod +x "$tmp/bin/orca"

export PATH="$tmp/bin:$PATH" FAKE_ORCA="$tmp/orca" FACTORY_POLL_SECONDS=0
result="$tmp/result.json"
open='[{"handle": "term_1", "agentIdentity": "claude"}]'

# Sets up the terminals, the answers to the waits, and the result file,
# where "none" means no file.
setup() {
  echo "$1" >"$FAKE_ORCA/terminals.json"
  tr " " "\n" <<<"$2" >"$FAKE_ORCA/waits"
  rm -f "$result" "$FAKE_ORCA/on-list" "$FAKE_ORCA/on-wait"
  [ "$3" = none ] || echo "$3" >"$result"
}

# Writes a script for the fake orca to run once, from $2.
hook() {
  printf '#!/usr/bin/env bash\n%s\n' "$2" >"$FAKE_ORCA/$1"
  chmod +x "$FAKE_ORCA/$1"
}

failures=0
check() {
  local name=$1 want=$2 got
  got=$("$root/sdlc/bin/await-result" "$result" term_1 path:/demo 2>"$tmp/stderr") ||
    got="failed: $(tail -n 1 "$tmp/stderr")"
  if [ "$got" = "$want" ]; then
    echo "ok: $name"
  else
    echo "FAIL: $name: want $want, got $got"
    failures=$((failures + 1))
  fi
}

setup "$open" true '{"status": "done"}'
check "a result read once the agent is idle" '{"status":"done"}'

setup "$open" true none
hook on-list "echo '{\"status\": \"done\"}' >'$result'"
check "waits for the result file to appear" '{"status":"done"}'

setup "$open" true '{"summary": "first"}'
hook on-wait "echo '{\"summary\": \"second\"}' >'$result'"
check "the agent's edits before it goes idle count" '{"summary":"second"}'

setup "$open" "false true" '{"summary": "first"}'
hook on-wait "echo '{\"summary\": \"second\"}' >'$result'"
check "keeps waiting while the agent stays busy" '{"summary":"second"}'

setup '[]' "" '{"status": "done"}'
check "a result whose terminal closed is read as it is" '{"status":"done"}'

setup '[]' "" none
check "a terminal that closes without a result fails" \
  "failed: await-result: the agent's terminal term_1 closed without writing $result"

setup "$open" true '{"status": "done", "summ'
check "a result that isn't JSON fails" \
  "failed: await-result: $result isn't a JSON object. Fix it, then retry the step."

setup "$open" true '"done"'
check "a result that isn't an object fails" \
  "failed: await-result: $result isn't a JSON object. Fix it, then retry the step."

[ "$failures" -eq 0 ] || { echo "$failures failed"; exit 1; }
