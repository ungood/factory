#!/usr/bin/env bash
# Tests sdlc/bin/prepare against a fake orca that makes plain git worktrees,
# and a fake gh that serves a canned issue.
#
# Usage: sdlc/test/prepare
set -euo pipefail

root=$(cd "$(dirname "$0")/../.." && pwd)
tmp=$(mktemp -d "${TMPDIR:-/tmp}/prepare-test.XXXXXX")
tmp=$(cd "$tmp" && pwd -P)
trap 'rm -rf "$tmp"' EXIT

mkdir -p "$tmp/bin" "$tmp/orca" "$tmp/worktrees"
cat >"$tmp/bin/gh" <<'GH'
#!/usr/bin/env bash
case "$1 $2" in
  "repo view") echo ungood/demo ;;
  "issue view") printf '# Demo issue\n\nDo the thing.\n' ;;
  *) echo "fake gh: unexpected call: $*" >&2; exit 1 ;;
esac
GH
# The fake orca knows every repo under $tmp, and keeps its worktrees in
# $FAKE_ORCA/<repo>.json. Each create is logged to $FAKE_ORCA/creates.
cat >"$tmp/bin/orca" <<'ORCA'
#!/usr/bin/env bash
arg() { local want=$1; shift; while [ $# -gt 0 ]; do [ "$1" = "$want" ] && { echo "$2"; return; }; shift; done; }
list() { cat "$FAKE_ORCA/$1.json" 2>/dev/null || echo '[]'; }
case "$1 $2" in
  "repo list")
    for d in "$FAKE_ROOT"/*/.git; do d=$(dirname "$d"); jq -n --arg p "$d" --arg id "$(basename "$d")" '{id: $id, path: $p}'; done |
      jq -s '{result: {repos: .}}' ;;
  "worktree list")
    id=$(arg --repo "$@"); id=${id#id:}
    list "$id" | jq '{result: {worktrees: .}}' ;;
  "worktree create")
    id=$(arg --repo "$@"); id=${id#id:}; name=$(arg --name "$@")
    path="$FAKE_ROOT/worktrees/$name"
    git -C "$FAKE_ROOT/$id" worktree add --quiet -b "test/$name" "$path" >&2 || exit 1
    echo "$name" >>"$FAKE_ORCA/creates"
    wt=$(jq -n --arg p "$path" --arg b "refs/heads/test/$name" --arg id "$id::$path" '{id: $id, path: $p, branch: $b}')
    list "$id" | jq --argjson wt "$wt" '. + [$wt]' >"$FAKE_ORCA/$id.json.tmp"
    mv "$FAKE_ORCA/$id.json.tmp" "$FAKE_ORCA/$id.json"
    jq -n --argjson wt "$wt" '{result: {worktree: $wt}}' ;;
  *) echo "fake orca: unexpected call: $*" >&2; exit 1 ;;
esac
ORCA
chmod +x "$tmp/bin/gh" "$tmp/bin/orca"

export PATH="$tmp/bin:$PATH" FAKE_ORCA="$tmp/orca" FAKE_ROOT="$tmp" XDG_STATE_HOME="$tmp/state"
# Keep the user's mise config and trust list out of the throwaway repos.
# Tools shimmed by mise still read this checkout's config, so trust it.
export MISE_CONFIG_DIR="$tmp/mise-config" MISE_GLOBAL_CONFIG_FILE="$tmp/mise-config/config.toml" \
  MISE_STATE_DIR="$tmp/mise-state" MISE_TRUSTED_CONFIG_PATHS="$root"

# Makes a repo whose committed mise.toml is $2. Each task appends its name
# to ran.log, which git ignores.
repo() {
  local dir="$tmp/$1"
  git init --quiet -b main "$dir"
  git -C "$dir" remote add origin "https://github.com/ungood/$1.git"
  printf 'ran.log\n' >"$dir/.gitignore"
  printf '%s\n' "$2" >"$dir/mise.toml"
  git -C "$dir" add .gitignore mise.toml
  git -C "$dir" -c user.name=test -c user.email=test@example.com commit --quiet -m base
}

failures=0
expect() {
  local name=$1 want=$2 got=$3
  if [ "$got" = "$want" ]; then
    echo "ok: $name"
  else
    echo "FAIL: $name: want $want, got $got"
    failures=$((failures + 1))
  fi
}
prepare() { "$root/sdlc/bin/prepare" "$tmp/$1" "$2" 2>"$tmp/$1-$2.err"; }

repo app '
[tasks.install]
run = "echo install >>ran.log"'
wt="$tmp/worktrees/issue-7"

got=$(prepare app 7) || got="failed: $(cat "$tmp/app-7.err")"
expect "prints the worktree and its branch" "{\"worktree\":\"$wt\",\"branch\":\"test/issue-7\"}" "$got"
expect "runs the repo's install task in the worktree" install "$(cat "$wt/ran.log" 2>/dev/null)"
expect "saves the issue for the agent" "# Demo issue" "$(head -1 "$tmp/state/factory/agents/app-7/issue.md" 2>/dev/null)"

got=$(prepare app 7) || got="failed: $(cat "$tmp/app-7.err")"
expect "a retry reuses the worktree" "{\"worktree\":\"$wt\",\"branch\":\"test/issue-7\"}" "$got"
expect "a retry creates no second worktree" issue-7 "$(cat "$tmp/orca/creates")"

repo plain '
[tasks.test]
run = "echo test >>ran.log"'
got=$(prepare plain 8) || got="failed: $(cat "$tmp/plain-8.err")"
expect "a repo without an install task is ready as it is" \
  "{\"worktree\":\"$tmp/worktrees/issue-8\",\"branch\":\"test/issue-8\"}" "$got"

repo broken '
[tasks.install]
run = ["echo the registry is down", "exit 1"]'
if prepare broken 9 >/dev/null; then
  expect "a failing install task fails the step" failed passed
else
  expect "a failing install task fails the step" failed failed
fi
if grep -q "the registry is down" "$tmp/broken-9.err"; then
  expect "a failing install task's output is in the log" yes yes
else
  expect "a failing install task's output is in the log" yes "no: $(cat "$tmp/broken-9.err")"
fi

[ "$failures" -eq 0 ] || { echo "$failures failed"; exit 1; }
