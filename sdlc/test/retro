#!/usr/bin/env bash
# Tests sdlc/bin/retro against a fake gh, mise, marche and claude, checking
# what it hands the review and which issues it files.
#
# Usage: sdlc/test/retro
set -euo pipefail

root=$(cd "$(dirname "$0")/../.." && pwd)
tmp=$(mktemp -d "${TMPDIR:-/tmp}/retro-test.XXXXXX")
trap 'rm -rf "$tmp"' EXIT

# The fakes answer from, and record into, files in $tmp/fake.
mkdir -p "$tmp/bin" "$tmp/fake" "$tmp/config" "$tmp/state/factory/agents/demo-7"
cat >"$tmp/bin/gh" <<'GH'
#!/usr/bin/env bash
case "$1 $2" in
  "repo view") sed -e 's#.*github\.com/##' -e 's#\.git$##' <<<"$3" ;;
  "pr diff") echo "diff --git a/a b/a" ;;
  "pr view") echo MERGED ;;
  "api user") echo ungood ;;
  "api --paginate")
    case "$3" in
      */pulls/*/reviews) cat "$FAKE/reviews.json" ;;
      */pulls/*/comments) echo '[]' ;;
      */issues/*/comments) echo '[]' ;;
    esac ;;
  "label create") ;;
  "issue create")
    shift 2
    while [ $# -gt 0 ]; do
      case "$1" in
        -R) repo=$2 ;;
        --title) title=$2 ;;
        --body) body=$2 ;;
      esac
      shift 2
    done
    jq -cn --arg repo "$repo" --arg title "$title" --arg body "$body" '{$repo, $title, $body}' >>"$FAKE/filed"
    echo "https://github.com/$repo/issues/$(wc -l <"$FAKE/filed" | tr -d ' ')" ;;
  *) echo "fake gh: unexpected call: $*" >&2; exit 1 ;;
esac
GH
cat >"$tmp/bin/mise" <<'MISE'
#!/usr/bin/env bash
jq -cn --arg dir "$FAKE_CONFIG" '{CLAUDE_CONFIG_DIR: $dir}'
MISE
cat >"$tmp/bin/marche" <<'MARCHE'
#!/usr/bin/env bash
echo '{"tasks": []}'
MARCHE
# The review keeps a copy of what it was handed, and answers with
# $FAKE/review.json.
cat >"$tmp/bin/claude" <<'CLAUDE'
#!/usr/bin/env bash
cp -R . "$FAKE/inputs"
jq -c '{is_error: false, structured_output: .}' "$FAKE/review.json"
CLAUDE
chmod +x "$tmp/bin"/*

git init --quiet "$tmp/workplace"
git -C "$tmp/workplace" remote add origin https://github.com/ungood/factory.git
git init --quiet "$tmp/demo"
git -C "$tmp/demo" remote add origin https://github.com/ungood/demo.git
state="$tmp/state/factory/agents/demo-7"
echo "# The issue" >"$state/issue.md"
echo '{"status": "done"}' >"$state/result.json"

export MISE_STATE_DIR="${MISE_STATE_DIR:-${XDG_STATE_HOME:-$HOME/.local/state}/mise}"
export PATH="$tmp/bin:$PATH" FAKE="$tmp/fake" FAKE_CONFIG="$tmp/config" XDG_STATE_HOME="$tmp/state"
url=https://github.com/ungood/demo/pull/9

failures=0
fail() {
  echo "FAIL: $*"
  failures=$((failures + 1))
}

# The pull request was merged together with a review that holds two ideas
# for follow-up work, and the retrospective's own analysis found three
# issues, its limit.
cat >"$FAKE/reviews.json" <<'JSON'
[{"id": 1, "user": {"login": "ungood"}, "state": "COMMENTED", "html_url": "https://github.com/ungood/demo/pull/9#pullrequestreview-1",
  "body": "Follow-ups:\n- Test the scripts\n- Make the prompts skills"}]
JSON
cat >"$FAKE/review.json" <<'JSON'
{
  "issues": [
    {"repo": "ungood/factory", "title": "Retro one", "body": "Evidence one"},
    {"repo": "ungood/factory", "title": "Retro two", "body": "Evidence two"},
    {"repo": "ungood/demo", "title": "Retro three", "body": "Evidence three"}
  ],
  "followUps": [
    {"repo": "ungood/factory", "title": "Test the scripts", "body": "The reviewer asked for tests.",
     "comment": "https://github.com/ungood/demo/pull/9#pullrequestreview-1"},
    {"repo": "ungood/factory", "title": "Make the prompts skills", "body": "The reviewer asked for skills.",
     "comment": "https://github.com/ungood/demo/pull/9#pullrequestreview-1"}
  ]
}
JSON

out=$(cd "$tmp/workplace" && "$root/sdlc/bin/retro" "$tmp/demo" 7 "$tmp/worktree" "$url" run-1 2>"$tmp/stderr") ||
  fail "retro exited non-zero"

if jq -e '.[] | select(.id == "review:1")' "$FAKE/inputs/unhandled.json" >/dev/null 2>&1; then
  echo "ok: the review is handed the feedback left with the merge"
else
  fail "the review wasn't handed the feedback left with the merge"
fi

if [ "$(jq length <<<"$out")" = 5 ] && [ "$(wc -l <"$FAKE/filed" | tr -d ' ')" = 5 ]; then
  echo "ok: the reviewer's follow-ups are filed on top of the retrospective's three issues"
else
  fail "want 5 issues filed, got $out"
  cat "$tmp/stderr"
fi

if jq -se 'map(select(.title == "Test the scripts"))[0].body
    | contains("https://github.com/ungood/demo/pull/9#pullrequestreview-1")' "$FAKE/filed" >/dev/null; then
  echo "ok: a follow-up links the comment it came from"
else
  fail "a follow-up doesn't link the comment it came from"
fi

[ "$failures" -eq 0 ] || { echo "$failures failed"; exit 1; }
