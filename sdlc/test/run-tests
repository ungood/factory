#!/usr/bin/env bash
# Tests sdlc/run-tests against clones of this commit, each with one more
# commit that breaks a rule the workflow check enforces, while the working
# tree hides the break.
#
# Usage: sdlc/test/run-tests
set -euo pipefail

root=$(cd "$(dirname "$0")/../.." && pwd)
tmp=$(mktemp -d "${TMPDIR:-/tmp}/run-tests-test.XXXXXX")
trap 'rm -rf "$tmp"' EXIT

export GIT_AUTHOR_NAME=test GIT_AUTHOR_EMAIL=test@example.com
export GIT_COMMITTER_NAME=test GIT_COMMITTER_EMAIL=test@example.com
git clone --quiet "$root" "$tmp/factory"
clone="$tmp/factory"
base=$(git -C "$clone" rev-parse HEAD)

# Resets the clone to this commit, with a clean working tree.
reset() {
  git -C "$clone" reset --quiet --hard "$base"
  git -C "$clone" clean --quiet -fdx
}

failures=0
# Runs the workflow check in the clone, and wants it to pass, or to fail
# with $3 in its output.
check() {
  local name=$1 want=$2 why=${3-} got
  if "$clone/sdlc/run-tests" sdlc/test/workflow >"$tmp/out" 2>&1; then got=passed; else got=failed; fi
  if [ "$got" = "$want" ] && grep -qF -- "$why" "$tmp/out"; then
    echo "ok: $name"
  else
    echo "FAIL: $name: want $want, got $got"
    sed 's/^/  /' "$tmp/out"
    failures=$((failures + 1))
  fi
}

reset
check "this commit passes" passed

reset
git -C "$clone" update-index --chmod=-x sdlc/bin/reply
git -C "$clone" commit --quiet -m "drop reply's executable bit"
chmod +x "$clone/sdlc/bin/reply"
check "a commit that drops a script's executable bit fails, though the working tree has it" failed \
  "sdlc/bin/reply, which a workflow runs, is committed with mode 100644, not 100755"

reset
chmod -x "$clone/sdlc/bin/reply"
check "a working tree that drops a script's executable bit passes, since the commit has it" passed

reset
# shellcheck disable=SC2016 # The line is for the test, which expands it.
printf '\nbash "$root/sdlc/bin/gate"\n' >>"$clone/sdlc/test/gate"
git -C "$clone" commit --quiet -am "run gate through bash"
check "a test that runs a script through bash fails" failed \
  "a test runs a script through a shell instead of by path"

# The workflow check counts any test that names a script's path, this one
# included, so the scripts below are named through a variable.
bin=sdlc/bin
reset
cp "$clone/$bin/gate" "$clone/$bin/untested"
git -C "$clone" add "$bin/untested"
sed "s#$bin/gate#$bin/untested#" "$clone/sdlc/implement.yaml" >"$clone/sdlc/untested.yaml"
git -C "$clone" add sdlc/untested.yaml
git -C "$clone" commit --quiet -m "run a script no test runs"
check "a workflow that runs a script no test runs fails" failed \
  "$bin/untested, which a workflow runs, isn't run by path in any test"

reset
cp "$clone/$bin/gate" "$clone/$bin/uncommitted"
sed "s#$bin/gate#$bin/uncommitted#" "$clone/sdlc/implement.yaml" >"$clone/sdlc/uncommitted.yaml"
git -C "$clone" add sdlc/uncommitted.yaml
git -C "$clone" commit --quiet -m "run a script that isn't committed"
# shellcheck disable=SC2016 # The line is for the test, which expands it.
printf '\n"$root/%s/uncommitted"\n' "$bin" >>"$clone/sdlc/test/gate"
git -C "$clone" commit --quiet -am "run it in a test"
check "a workflow that runs a script that's only in the working tree fails" failed \
  "$bin/uncommitted, which a workflow runs, isn't committed"

[ "$failures" -eq 0 ] || { echo "$failures failed"; exit 1; }
