#!/usr/bin/env bash
# Tests sdlc/bin/announce-pr against a fake orca that records its calls, and
# can fail them.
#
# Usage: sdlc/test/announce-pr
set -euo pipefail

root=$(cd "$(dirname "$0")/../.." && pwd)
tmp=$(mktemp -d "${TMPDIR:-/tmp}/announce-pr-test.XXXXXX")
trap 'rm -rf "$tmp"' EXIT

# The fake orca appends each call to $FAKE/calls, one argument per line,
# then fails if $FAKE/fail exists.
mkdir -p "$tmp/bin" "$tmp/fake" "$tmp/state/factory/agents/demo-7"
cat >"$tmp/bin/orca" <<'ORCA'
#!/usr/bin/env bash
printf '%s\n' "$*" >>"$FAKE/calls"
[ ! -f "$FAKE/fail" ]
ORCA
chmod +x "$tmp/bin/orca"
git init --quiet "$tmp/demo"

# mise keeps its trusted configs under XDG_STATE_HOME, so keep it pointed at
# the real one.
export MISE_STATE_DIR="${MISE_STATE_DIR:-${XDG_STATE_HOME:-$HOME/.local/state}/mise}"
export PATH="$tmp/bin:$PATH" FAKE="$tmp/fake" XDG_STATE_HOME="$tmp/state"
state="$tmp/state/factory/agents/demo-7"
url=https://github.com/ungood/demo/pull/9

failures=0
check() {
  local name=$1 want=$2 got
  if "$root/sdlc/bin/announce-pr" "$tmp/demo" 7 /worktree "$3" 2>/dev/null; then
    got=$(cat "$FAKE/calls" 2>/dev/null || true)
  else
    got="failed"
  fi
  if [ "$got" = "$want" ]; then
    echo "ok: $name"
  else
    echo "FAIL: $name: want $want, got $got"
    failures=$((failures + 1))
  fi
  rm -f "$FAKE/calls" "$FAKE/fail"
}

set_worktree="worktree set --worktree path:/worktree --pr 9 --workspace-status in-review --comment PR #9 is ready for review --unread --json"
send="terminal send --terminal term_1 --text The workflow opened $url for this work. --enter --json"

echo term_1 >"$state/terminal"
check "links the pull request and tells the agent's terminal" "$set_worktree"$'\n'"$send" "$url"$'\n'

check "a URL without a pull request number does nothing" "" https://github.com/ungood/demo

touch "$FAKE/fail"
check "never fails when Orca does" "$set_worktree"$'\n'"$send" "$url"

rm "$state/terminal"
check "without the agent's terminal, only links the pull request" "$set_worktree" "$url"

[ "$failures" -eq 0 ] || { echo "$failures failed"; exit 1; }
