#!/usr/bin/env bash
# Tests sdlc/bin/gate against throwaway repos whose mise tasks record that
# they ran.
#
# Usage: sdlc/test/gate
set -euo pipefail

root=$(cd "$(dirname "$0")/../.." && pwd)
tmp=$(mktemp -d "${TMPDIR:-/tmp}/gate-test.XXXXXX")
trap 'rm -rf "$tmp"' EXIT

# Keep the user's mise config and trust list out of the throwaway repos.
# Tools shimmed by mise still read this checkout's config, so trust it.
export MISE_CONFIG_DIR="$tmp/mise-config" MISE_GLOBAL_CONFIG_FILE="$tmp/mise-config/config.toml" \
  MISE_STATE_DIR="$tmp/mise-state" MISE_TRUSTED_CONFIG_PATHS="$root"

# Makes a repo with one commit beyond origin/main, whose mise.toml is $2.
# Each task appends its name to ran.log, which git ignores.
repo() {
  local dir="$tmp/$1"
  git init --quiet -b main "$dir"
  printf 'ran.log\n' >"$dir/.gitignore"
  git -C "$dir" add .gitignore
  git -C "$dir" -c user.name=test -c user.email=test@example.com commit --quiet -m base
  git -C "$dir" update-ref refs/remotes/origin/main HEAD
  printf '%s\n' "$2" >"$dir/mise.toml"
  git -C "$dir" add mise.toml
  git -C "$dir" -c user.name=test -c user.email=test@example.com commit --quiet -m work
}

failures=0
check() {
  local name=$1 dir="$tmp/$2" want=$3 got
  if "$root/sdlc/bin/gate" "$dir" >"$tmp/$2.out" 2>&1; then
    got="passed: $(paste -sd, "$dir/ran.log" 2>/dev/null || true)"
  else
    got="failed: $(paste -sd, "$dir/ran.log" 2>/dev/null || true)"
  fi
  if [ "$got" = "$want" ]; then
    echo "ok: $name"
  else
    echo "FAIL: $name: want $want, got $got"
    sed 's/^/  /' "$tmp/$2.out"
    failures=$((failures + 1))
  fi
}

repo lint-test '
[tasks.lint]
run = "echo lint >>ran.log"
[tasks.test]
run = "echo test >>ran.log"'
check "a repo without ci runs lint and test" lint-test "passed: lint,test"

repo ci '
[tasks.ci]
run = "echo ci >>ran.log"
[tasks.lint]
run = "echo lint >>ran.log"
[tasks.test]
run = "echo test >>ran.log"'
check "a repo with ci runs only ci" ci "passed: ci"

repo ci-fails '
[tasks.ci]
run = ["echo ci >>ran.log", "exit 1"]'
check "a failing ci task fails the gate" ci-fails "failed: ci"

repo test-only '
[tasks.test]
run = "echo test >>ran.log"'
check "a missing lint task is skipped" test-only "passed: test"

[ "$failures" -eq 0 ] || { echo "$failures failed"; exit 1; }
