#!/usr/bin/env bash
# Tests sdlc/bin/cleanup against a fake gh that serves a canned pull request
# and a fake orca that records the worktrees it's asked to remove.
#
# Usage: sdlc/test/cleanup
set -euo pipefail

root=$(cd "$(dirname "$0")/../.." && pwd)
tmp=$(mktemp -d "${TMPDIR:-/tmp}/cleanup-test.XXXXXX")
trap 'rm -rf "$tmp"' EXIT

mkdir -p "$tmp/bin" "$tmp/gh"
cat >"$tmp/bin/gh" <<'GH'
#!/usr/bin/env bash
case "$1 $2" in
  "pr view") cat "$FAKE_GH/pr" ;;
  *) echo "fake gh: unexpected call: $*" >&2; exit 1 ;;
esac
GH
cat >"$tmp/bin/orca" <<'ORCA'
#!/usr/bin/env bash
case "$1 $2" in
  "worktree rm") echo "$4" >>"$FAKE_ORCA" ;;
esac
ORCA
chmod +x "$tmp/bin/gh" "$tmp/bin/orca"

export PATH="$tmp/bin:$PATH" FAKE_GH="$tmp/gh" FAKE_ORCA="$tmp/removed"
export GIT_AUTHOR_NAME=test GIT_AUTHOR_EMAIL=test@example.com
export GIT_COMMITTER_NAME=test GIT_COMMITTER_EMAIL=test@example.com
url=https://github.com/ungood/demo/pull/9

git init --quiet --bare -b main "$tmp/origin.git"
git clone --quiet "$tmp/origin.git" "$tmp/demo" 2>/dev/null
git -C "$tmp/demo" commit --quiet --allow-empty -m init
git -C "$tmp/demo" push --quiet origin main

# Makes a worktree on a new branch with one commit, pushed to the remote, and
# serves a pull request in the given state whose head is that commit.
worktree() {
  local name=$1 state=$2
  git -C "$tmp/demo" worktree add --quiet -b "$name" "$tmp/$name" main
  git -C "$tmp/$name" commit --quiet --allow-empty -m "work on $name"
  git -C "$tmp/$name" push --quiet origin "$name"
  echo "$state $(git -C "$tmp/$name" rev-parse HEAD)" >"$FAKE_GH/pr"
  rm -f "$FAKE_ORCA"
}

# Deletes the worktree's remote branch, as GitHub does after a merge.
delete_remote_branch() {
  git -C "$tmp/demo" push --quiet origin --delete "$1"
  git -C "$tmp/demo" fetch --quiet --prune
}

failures=0
check() {
  local name=$1 branch=$2 want=$3 got=kept
  "$root/sdlc/bin/cleanup" "$tmp/demo" "$tmp/$branch" "$branch" "$url"$'\n' 2>/dev/null
  if [ -f "$FAKE_ORCA" ] && grep -qxF "path:$tmp/$branch" "$FAKE_ORCA"; then
    got=removed
  fi
  if [ "$got" = "$want" ]; then
    echo "ok: $name"
  else
    echo "FAIL: $name: want $want, got $got"
    failures=$((failures + 1))
  fi
}

# A merge commit keeps the branch's commits, so they're on main's remote.
worktree merged MERGED
git -C "$tmp/demo" push --quiet origin merged:main
delete_remote_branch merged
check "a worktree merged with a merge commit is removed" merged removed

# A squash merge puts a new commit on main, so the branch's commits are on no
# remote once its remote branch is gone.
worktree squashed MERGED
git -C "$tmp/demo" pull --quiet
git -C "$tmp/demo" commit --quiet --allow-empty -m "squashed"
git -C "$tmp/demo" push --quiet origin main
delete_remote_branch squashed
check "a worktree squash merged is removed" squashed removed

worktree unpushed MERGED
git -C "$tmp/unpushed" commit --quiet --allow-empty -m "never pushed"
delete_remote_branch unpushed
check "a worktree with commits that never reached the pull request is kept" unpushed kept

worktree dirty MERGED
delete_remote_branch dirty
touch "$tmp/dirty/new-file"
check "a squash merged worktree with uncommitted changes is kept" dirty kept

worktree open OPEN
delete_remote_branch open
check "a worktree whose pull request isn't merged is kept" open kept

[ "$failures" -eq 0 ] || { echo "$failures failed"; exit 1; }
