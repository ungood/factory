#!/usr/bin/env bash
# Tests sdlc/bin/open-pr against a local remote and a fake gh that records
# the pull requests it's asked to open.
#
# Usage: sdlc/test/open-pr
set -euo pipefail

root=$(cd "$(dirname "$0")/../.." && pwd)
tmp=$(mktemp -d "${TMPDIR:-/tmp}/open-pr-test.XXXXXX")
trap 'rm -rf "$tmp"' EXIT

# The fake gh serves the branch's pull request from $FAKE_GH/url, if it
# exists, and records the arguments of a created one in $FAKE_GH/created,
# one per line.
mkdir -p "$tmp/bin" "$tmp/gh"
cat >"$tmp/bin/gh" <<'GH'
#!/usr/bin/env bash
case "$1 $2" in
  "pr view") cat "$FAKE_GH/url" 2>/dev/null ;;
  "pr create")
    shift 2
    printf '%s\n' "$@" >"$FAKE_GH/created"
    echo https://github.com/ungood/demo/pull/9 ;;
  *) echo "fake gh: unexpected call: $*" >&2; exit 1 ;;
esac
GH
chmod +x "$tmp/bin/gh"

export PATH="$tmp/bin:$PATH" FAKE_GH="$tmp/gh"
export GIT_AUTHOR_NAME=test GIT_AUTHOR_EMAIL=test@example.com
export GIT_COMMITTER_NAME=test GIT_COMMITTER_EMAIL=test@example.com

git init --quiet --bare -b main "$tmp/origin.git"
git clone --quiet "$tmp/origin.git" "$tmp/demo" 2>/dev/null
git -C "$tmp/demo" commit --quiet --allow-empty -m init
git -C "$tmp/demo" push --quiet origin main

failures=0
fail() {
  echo "FAIL: $*"
  failures=$((failures + 1))
}

git -C "$tmp/demo" switch --quiet -c ungood/issue-7
git -C "$tmp/demo" commit --quiet --allow-empty -m "fix: the thing"
got=$("$root/sdlc/bin/open-pr" "$tmp/demo" 7 "fix: the thing" "It's fixed." 2>"$tmp/stderr") ||
  got="failed: $(cat "$tmp/stderr")"
want=$(printf '%s\n' --draft --title "fix: the thing" --body "It's fixed." "" "Closes #7")
if [ "$got" != https://github.com/ungood/demo/pull/9 ]; then
  fail "a new branch prints its pull request's URL: got $got"
elif [ "$(cat "$tmp/gh/created")" != "$want" ]; then
  fail "a new branch gets a draft pull request that closes the issue: want $want, got $(cat "$tmp/gh/created")"
elif [ "$(git -C "$tmp/origin.git" rev-parse ungood/issue-7)" != "$(git -C "$tmp/demo" rev-parse HEAD)" ]; then
  fail "a new branch is pushed"
else
  echo "ok: a new branch is pushed and gets a draft pull request that closes the issue"
fi

rm "$tmp/gh/created"
echo https://github.com/ungood/demo/pull/8 >"$tmp/gh/url"
git -C "$tmp/demo" commit --quiet --allow-empty -m "fix: more"
got=$("$root/sdlc/bin/open-pr" "$tmp/demo" 7 "fix: the thing" "It's fixed." 2>"$tmp/stderr") ||
  got="failed: $(cat "$tmp/stderr")"
if [ "$got" != https://github.com/ungood/demo/pull/8 ] || [ -f "$tmp/gh/created" ]; then
  fail "a branch with a pull request prints its URL and opens no other: got $got"
elif [ "$(git -C "$tmp/origin.git" rev-parse ungood/issue-7)" != "$(git -C "$tmp/demo" rev-parse HEAD)" ]; then
  fail "a branch with a pull request is pushed"
else
  echo "ok: a branch with a pull request is pushed, and its URL printed"
fi

[ "$failures" -eq 0 ] || { echo "$failures failed"; exit 1; }
