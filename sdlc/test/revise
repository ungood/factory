#!/usr/bin/env bash
# Tests sdlc/bin/revise against a fake orca whose agent answers the feedback
# it's sent, and a fake gh that serves the reviewer's feedback.
#
# Usage: sdlc/test/revise
set -euo pipefail

root=$(cd "$(dirname "$0")/../.." && pwd)
tmp=$(mktemp -d "${TMPDIR:-/tmp}/revise-test.XXXXXX")
trap 'rm -rf "$tmp"' EXIT

# The fake orca lists the terminals in $FAKE/terminals.json, logs what it
# types to $FAKE/sent, and, sent a task, writes $FAKE/answer.json to the
# round's result file, as the agent would.
mkdir -p "$tmp/bin" "$tmp/fake" "$tmp/state/factory/agents/demo-7"
cat >"$tmp/bin/orca" <<'ORCA'
#!/usr/bin/env bash
case "$1 $2" in
  "terminal list") jq -c '{result: {terminals: .}}' "$FAKE/terminals.json" ;;
  "terminal wait") echo '{"result": {"wait": {"satisfied": true}}}' ;;
  "terminal send")
    echo "$6" >>"$FAKE/sent"
    cp "$FAKE/answer.json" "$RESULT" ;;
  "worktree set") ;;
  *) echo "fake orca: unexpected call: $*" >&2; exit 1 ;;
esac
ORCA
# The fake gh serves one inline comment from the reviewer.
cat >"$tmp/bin/gh" <<'GH'
#!/usr/bin/env bash
case "$1 $2" in
  "pr view") echo OPEN ;;
  "api user") echo ungood ;;
  "api --paginate")
    case "$3" in
      */pulls/*/comments) echo '[{"id": 5, "user": {"login": "ungood"}, "body": "Rename this.", "path": "a", "line": 1, "html_url": "u"}]' ;;
      *) echo '[]' ;;
    esac ;;
  *) echo "fake gh: unexpected call: $*" >&2; exit 1 ;;
esac
GH
chmod +x "$tmp/bin"/*
git init --quiet "$tmp/demo"

export MISE_STATE_DIR="${MISE_STATE_DIR:-${XDG_STATE_HOME:-$HOME/.local/state}/mise}"
state="$tmp/state/factory/agents/demo-7"
export PATH="$tmp/bin:$PATH" FAKE="$tmp/fake" XDG_STATE_HOME="$tmp/state" FACTORY_POLL_SECONDS=0 \
  RESULT="$state/result-2.json"
url=https://github.com/ungood/demo/pull/9
claude='[{"handle": "term_1", "agentIdentity": "claude"}]'

# Starts a round from scratch: the agent's terminal and what it runs, and
# the agent's answer.
setup() {
  rm -f "$state"/* "$FAKE/sent"
  echo term_1 >"$state/terminal"
  echo "$1" >"$FAKE/terminals.json"
  echo "$2" >"$FAKE/answer.json"
}

failures=0
check() {
  local name=$1 want=$2 got
  got=$("$root/sdlc/bin/revise" "$tmp/demo" 7 /worktree "$url"$'\n' 2 2>"$tmp/stderr") ||
    got="failed: $(tail -n 1 "$tmp/stderr")"
  if [ "$got" = "$want" ]; then
    echo "ok: $name"
  else
    echo "FAIL: $name: want $want, got $got"
    failures=$((failures + 1))
  fi
}
fail() {
  echo "FAIL: $*"
  failures=$((failures + 1))
}

setup "$claude" '{"status": "done", "replies": []}'
check "sends the feedback to the agent and prints its result" '{"status":"done","replies":[]}'
if [ "$(jq -c '[.[] | {kind, body}]' "$state/feedback-2.json")" != '[{"kind":"inline","body":"Rename this."}]' ]; then
  fail "writes the round's feedback: got $(cat "$state/feedback-2.json")"
elif [ "$(cat "$FAKE/sent")" != "Read $state/review-2.md and do what it says." ]; then
  fail "sends the round's task to the agent: got $(cat "$FAKE/sent")"
elif [ "$(jq -r '.[].id' "$state/feedback-2.json")" != "$(cat "$state/handled")" ]; then
  fail "records the round's feedback as handled"
else
  echo "ok: writes the round's feedback, sends it, and records it as handled"
fi

# A retried round waits for the result of the task the agent was already
# sent, without sending it again.
rm "$FAKE/sent" "$RESULT"
"$root/sdlc/bin/revise" "$tmp/demo" 7 /worktree "$url" 2 >"$tmp/retried" 2>/dev/null &
sleep 1
echo '{"status": "done", "replies": []}' >"$RESULT"
if ! wait $!; then
  fail "a retried round fails"
elif [ -f "$FAKE/sent" ]; then
  fail "a retried round sends the feedback twice: $(cat "$FAKE/sent")"
elif [ "$(cat "$tmp/retried")" != '{"status":"done","replies":[]}' ]; then
  fail "a retried round prints the agent's result: got $(cat "$tmp/retried")"
else
  echo "ok: a retried round doesn't send the feedback twice"
fi

setup "$claude" '{"status": "blocked", "summary": "stuck"}'
check "a blocked agent fails the round" "failed: revise: the agent reported blocked: stuck"

setup '[{"handle": "term_1"}]' '{}'
check "a terminal that no longer runs Claude fails the round" \
  "failed: revise: the agent's terminal term_1 runs a shell, not Claude, so nobody can address the feedback in $state/feedback-2.json. Starting a fresh agent isn't supported yet."
[ ! -f "$FAKE/sent" ] || fail "a terminal that no longer runs Claude was sent the feedback"

setup '[]' '{}'
check "a closed terminal fails the round" \
  "failed: revise: the agent's terminal term_1 has closed, so nobody can address the feedback in $state/feedback-2.json. Starting a fresh agent isn't supported yet."

[ "$failures" -eq 0 ] || { echo "$failures failed"; exit 1; }
